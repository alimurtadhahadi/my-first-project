void print_gaint_square(int n)
{
	for (int x = 0; x < n; x++)
	{
		for (int i = 1; i < 31; i++)
		{
			for (int j = 1; j < 61; j++)
			{
				if (j == 1 || j == 60)
				{

					if (i == 1)
					{
						cout << "_";
					}
					else if (i == 30)
					{
						cout << "-";
					}
					else
					{
						cout << "|";
					}


				}
				else if (i == 1)
				{
					cout << "_";

				}
				else if (i == 30)
				{
					cout << "-";
				}
				else if (j == 31 && i == 15)
				{
