#include <iostream>
using namespace std;
void Ascending_sequence()
{
	int start, end;
	cout << "Enter the starting number: ";
	cin >> start;
	cout << "Enter the ending number: ";
	cin >> end;
	for (int i = start; i <= end; i++)
	{
		cout << i << " ";
	}
	cout << endl;
}
void Descending_sequence()
{
	int start, end;
	cout << "Enter the starting number: ";
	cin >> start;
	cout << "Enter the ending number: ";
	cin >> end;
	for (int i = start; i >= end; i--)
	{
		cout << i << " ";
	}
	cout << endl;
}
void Sum_of_Odd_or_Even_sequence()
{
		int start, end;
		cout << "Enter the starting number: ";
		cin >> start;
		cout << "Enter the ending number: ";
		cin >> end;
		int sum = 0;
		for (int i = start; i <= end; i+=2)
		{
			sum += i;
		}
		if (start % 2 == 0)
			{
			cout << "The sum of even numbers between " << start << " and " << end << " is: " << sum << endl;
		}
		else
		{
			cout << "The sum of odd numbers between " << start << " and " << end << " is: " << sum << endl;
		}
}
void factorial()
{
	int num;
	cout << "Enter a number: ";
	cin >> num;
	int fact = 1;
	for (int i = 1; i <= num; i++)
	{
		fact *= i;
	}
	cout << "The factorial of " << num << " is: " << fact << endl;
}
void power_of_M()
{
	int num, power;
	cout << "Enter a number: ";
	cin >> num;
	cout << "Enter the power: ";
	cin >> power;
	int result = 1;
	for (int i = 1; i <= power; i++)
	{
		result *= num;
	}
	cout << num << " raised to the power of " << power << " is: " << result << endl;

}
