#include <iostream>
#include <string>
using namespace std;
struct questions
{
	string name;
	int age;
	bool hasDriverLicense;
};
void readUserAnswers(questions& User)
{
	cout << "Hi,what's your name" << endl;
	getline(cin, User.name);
	cout << "How old are you" << endl;
	cin >> User.age;
	cout << "Do you have driver license" << endl <<
		"please answer by 1 (for yes) or 0 (for no)" << endl;
	cin >> User.hasDriverLicense;
}
void printDecideValidding(questions User)
{
	if (User.age >= 21 && User.age <= 45 && User.hasDriverLicense == 1)
	{
		cout << "you are Valid" << endl;
	}
	else
	{
		cout << "you are Invalid" << endl;
	}
}
int main()
{
	questions User;
	readUserAnswers(User);
	printDecideValidding(User);

	return 0;

}
