 }
void circleInscribedSquare()
 {
	 cout << "Enter the radius of the circle: ";
	 cin >> r;
	 float side = r * sqrt(2);
	 cout << "The side length of the inscribed square is: " << side << endl;
}
void circleDescribedAroundSquare()
 {
	 cout << "Enter the side length of the square: ";
	 float side;
	 cin >> side;
	 float radius = (side * sqrt(2)) / 2;
	 cout << "The radius of the circumscribed circle is: " << radius << endl;
}
void circleThroughCircumference()
 {
	 cout << "Enter the circumference of the circle: ";
	 cin >> y;
	 float area = (y * y) / (4 * PI);
	 cout << "The area of the circle is: " << area << endl;
}
void circleInscribedInIsoscelesTriangle()
 {
	 cout << "Enter the base and height of the isosceles triangle: ";
	 float base, height;
	 cin >> base >> height;
	 float radius = (base * height) / (2 * sqrt((base * base) + (4 * height * height)));
	 cout << "The radius of the inscribed circle is: " << radius << endl;
}
void circleDescribedAroundIsoscelesTriangle()
 {
	 cout << "Enter the lengths of the equal sides and the base of the isosceles triangle: ";
	 float side, base;
	 cin >> side >> base;
	 float height = sqrt((side * side) - ((base * base) / 4));
	 float radius = (side * side * base) / (4 * sqrt(side * (side + base) * (side - base) * (side - base)));
	 cout << "The radius of the circumscribed circle is: " << radius << endl;
}
void circleinscribedAroundArbitraryTriangle()
 {
	 cout << "Enter the lengths of the sides of the triangle: ";
	 float a, b, c;
	 cin >> a >> b >> c;
	 float s = (a + b + c) / 2;
	 float area = sqrt(s * (s - a) * (s - b) * (s - c));
	 float radius = area / s;
	 cout << "The radius of the inscribed circle is: " << radius << endl;
}
void circleDescribedAroundArbitraryTriangle()
 {
	 cout << "Enter the lengths of the sides of the triangle: ";
	 float a, b, c;
	 cin >> a >> b >> c;
	 float s = (a + b + c) / 2;
	 float area = sqrt(s * (s - a) * (s - b) * (s - c));
	 float radius = (a * b * c) / (4 * area);
	 cout << "The radius of the circumscribed circle is: " << radius << endl;
}

