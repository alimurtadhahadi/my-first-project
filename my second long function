using namespace std;
const float PI = 3.14;
int x, y, r;
void circleArea ()
{
	 cout << "Enter the radius of the circle: ";
	 cin >> r;
	 float area = PI * r * r;
	 cout << "The area of the circle is: " << area << endl;

 }
void circleThroughDiameter()
 {
	 cout << "Enter the diameter of the circle: ";
	 cin >> y;
	 float area = PI * (y / 2) * (y / 2);
	 cout << "The area of the circle is: " << area << endl;
 }
void dimeterThroughArea()
 {
	 cout << "Enter the area of the circle: ";
	 cin >> y;
	 float diameter = 2 * sqrt(y / PI);
	 cout << "The diameter of the circle is: " << diameter << endl;
}
void circumference ()
 {
	 cout << "Enter the radius of the circle: ";
	 cin >> r;
	 float circumference = 2 * PI * r;
	 cout << "The circumference of the circle is: " << circumference << endl;
 }
void diametarThroughCircumference()
 {
	 cout << "Enter the circumference of the circle: ";
