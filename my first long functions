int RectangleAreaThrouhgDiagonalAndShortSide(int diagonal, int shortside)
{
	return diagonal * sqrt(pow(diagonal, 2) - pow(shortside, 2));
}

int circleArea(int radius)
{
	int PI = 3.14;
	return PI * pow(radius, 2);

}

int circleAreaThroughDiameter(int diameter)
{
	int PI = 3.14;
	return PI * pow(diameter / 2, 2);
} 

int circleAreainscrbibedInSquare(int side)
{
	int PI = 3.14;
	return PI * pow(side / 2, 2);
}

int CircleAreaAlongcircumference(int circumference)
{
	int PI = 3.14;
	return PI * pow(circumference / (2 * PI), 2);
}

int CircleAreaInscribedInIsoscelesTriangle(int base, int height)
{
	int PI = 3.14;
	return (base * height) / (4 * PI);
}

int CircleAreaCircleDescribedAroundArbitraryTriangle(int sideA, int sideB, int sideC)
{
	int PI = 3.14;
	int s = (sideA + sideB + sideC) / 2;
	return (sideA * sideB * sideC) / (4 * sqrt(s * (s - sideA) * (s - sideB) * (s - sideC)));
}

int Powers234(int x)
