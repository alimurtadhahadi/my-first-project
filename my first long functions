int TaskDurationInseconds(int day ,int hours, int minutes, int seconds)
{
	return (day * 3600 * 24) + (hours * 3600) + (minutes * 60) + seconds;
}

int secondsToMinutesHoursDays(int totalSeconds)
{
	int days;
	int hours;
	int minutes;
	int seconds;
	days = totalSeconds / (3600 * 24);
	hours = (totalSeconds % (3600 * 24)) / 3600;
	minutes = (totalSeconds % 3600) / 60;
	seconds = totalSeconds % 60;
	cout << "Days: " << days << ", Hours: " << hours
		<< ", Minutes: " << minutes << ", Seconds: " << seconds << endl;
	return 0;
}


