void print_element_before_user_number()
{

    

    int element_range_wanted;

    do {
        cout << "Enter a number between 1 and 118 to show the chemical element before it: ";
        cin >> element_range_wanted;

        if (element_range_wanted >= 1 && element_range_wanted <= 118)
        {
            for (int i = 0; i < 118; i++)
            {
                cout << i + 1 << ". " << elements[i] << " ---> " << symboles[i] << endl;
                if (i + 1 == element_range_wanted)
                {
                    break;
                }
            }
        }
        else
        {
            cout << "Invalid number, try again.\n";
        }

    } while (element_range_wanted < 1 || element_range_wanted > 118);
}
void transform_symbol_into_element_and_atomic_number()
{
    bool found;
    string symbol;
    do {
        found = false;
        cout << "please enter the the symbol (must be first letter capital otherwise small)or (type 0 to Exit) :";
        cin >> symbol;
        if (symbol == "0")
        {
            cout << "Exiting search..." << endl;
            break;
        }
        for (int i = 0; i <= 117; i++)
        {
            if (symboles[i] == symbol)
            {
                cout << symboles[i] << " is element :(" << elements[i] << ") and his atomic number is :" << i + 1 << endl;
                found = true;
                break;
            }
        }
        if (found == false)
        {
            cout << "Symbol not found! Remember: the first letter must be Capital (e.g., Ag, not ag)" << endl;
            cout << "------------------------------------------------------------------------------------------------------" << endl;
        }
    } while (found != true);
}
string format_input(string s)
{
    if (s.length() == 0) return s;
    s[0] = toupper(s[0]);
    for (int i = 1; i < (int)s.length(); i++) {
        s[i] = tolower(s[i]);
    }
    return s;
}
void  transform_element_into_symbol_and_atomic_number()
{
    bool found;
    string element;
    do {
        found = false;
        cout << "Please enter the element name (or type '0' to Exit): ";
        cin >> element;

        if (element == "0") {
            cout << "Exiting search..." << endl;
            break;
        }

        element = format_input(element);

        for (int i = 0; i < 118; i++) {
            if (elements[i] == element) {
                cout << " Result: " << elements[i] << " (" << symboles[i] << ") | Atomic Number: " << i + 1 << endl;
                found = true;
                break;
            }
        }

        if (found != true ) 
        {
            cout << "[-] Element not found! Please check your spelling." << endl;
            cout << "----------------------------------------------------------------------" << endl;
        }
    } while (found != true);
}
void transform_atomic_number_into_element_symbol()
{
    int atomic_num;
    do {
        cout << "please enter your atomic number (0 to Exit)" << endl;
        cin >> atomic_num;
        if (atomic_num <= 0 || atomic_num >= 119)
        {
            cout << "invalid atomic number please enter between 1 and 118" << endl;
        }
        else
        {
            cout << atomic_num << ". is (" << elements[atomic_num - 1] << ")  (" << symboles[atomic_num - 1] << ")" << endl;
        }
    } while (atomic_num != 0);
}
